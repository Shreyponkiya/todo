{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-test",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-morning",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron-evening",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron-night",
      "schedule": "15 18 * * *"
    }
  ]
}
